<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="650.0" prefWidth="780.0" spacing="20.0" styleClass="page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agrimatch.controller.DashboardController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="page-title" text="Dashboard" />
                  <Label styleClass="page-subtitle" text="Overview of farmers, buyers and produce nearing expiry" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRefresh" styleClass="btn-secondary" text="Refresh" />
         </children>
      </HBox>
      <HBox spacing="16.0">
         <children>
            <VBox maxWidth="Infinity" spacing="4.0" styleClass="card, kpi-card, kpi-green" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-caption" text="Farmers" />
                  <Label fx:id="farmersCount" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
            <VBox maxWidth="Infinity" spacing="4.0" styleClass="card, kpi-card, kpi-blue" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-caption" text="Buyers" />
                  <Label fx:id="buyersCount" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
            <VBox maxWidth="Infinity" spacing="4.0" styleClass="card, kpi-card, kpi-amber" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-caption" text="Available batches" />
                  <Label fx:id="batchesCount" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
            <VBox maxWidth="Infinity" spacing="4.0" styleClass="card, kpi-card, kpi-red" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-caption" text="Open requests" />
                  <Label fx:id="requestsCount" styleClass="kpi-value" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox maxHeight="Infinity" spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
         </padding>
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="section-title" text="Shelf-life watchlist" />
                  <Label styleClass="page-subtitle" text="Available batches closest to expiry (top 10)" />
               </children>
            </VBox>
            <TableView fx:id="expiringTable" maxHeight="Infinity" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="cropCol" prefWidth="130.0" text="Crop" />
                  <TableColumn fx:id="farmerCol" prefWidth="180.0" text="Farmer" />
                  <TableColumn fx:id="qtyCol" prefWidth="100.0" styleClass="col-numeric" text="Remaining" />
                  <TableColumn fx:id="priceCol" prefWidth="90.0" styleClass="col-numeric" text="Price/kg" />
                  <TableColumn fx:id="expiryCol" prefWidth="110.0" text="Expires" />
                  <TableColumn fx:id="daysCol" prefWidth="100.0" text="Time left" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label styleClass="placeholder-text" text="No available batches" />
               </placeholder>
            </TableView>
         </children>
      </VBox>
      <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="status-label" text="" />
   </children>
</VBox>
