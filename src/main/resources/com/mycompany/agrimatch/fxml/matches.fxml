<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="Infinity" maxWidth="Infinity" prefHeight="650.0" prefWidth="780.0" spacing="16.0" styleClass="page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agrimatch.controller.MatchesController">
   <stylesheets>
      <URL value="@../css/styles.css" />
   </stylesheets>
   <padding>
      <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label styleClass="page-title" text="Matches" />
                  <Label styleClass="page-subtitle" text="Ranked by shelf-life urgency, distance and price" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onRefresh" styleClass="btn-secondary" text="Refresh" />
         </children>
      </HBox>
      <VBox spacing="10.0" styleClass="card">
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
         </padding>
         <children>
            <Label styleClass="field-label" text="Buyer request" />
            <ComboBox fx:id="requestBox" maxWidth="Infinity" promptText="Choose an open request" />
            <Label fx:id="requestInfo" maxWidth="Infinity" styleClass="info-banner" text="" wrapText="true" />
         </children>
      </VBox>
      <VBox maxHeight="Infinity" spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
         </padding>
         <children>
            <Label styleClass="section-title" text="Ranked batches" />
            <TableView fx:id="matchTable" maxHeight="Infinity" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="rankCol" maxWidth="60.0" minWidth="40.0" prefWidth="48.0" text="#" />
                  <TableColumn fx:id="farmerCol" prefWidth="170.0" text="Farmer" />
                  <TableColumn fx:id="batchCol" prefWidth="70.0" text="Batch" />
                  <TableColumn fx:id="priceCol" prefWidth="90.0" styleClass="col-numeric" text="Price/kg" />
                  <TableColumn fx:id="distanceCol" prefWidth="90.0" styleClass="col-numeric" text="Distance" />
                  <TableColumn fx:id="daysCol" prefWidth="90.0" styleClass="col-numeric" text="Days left" />
                  <TableColumn fx:id="scoreCol" prefWidth="80.0" styleClass="col-numeric" text="Score" />
                  <TableColumn fx:id="qtyCol" prefWidth="100.0" styleClass="col-numeric" text="Suggested" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label styleClass="placeholder-text" text="Select a buyer request to see ranked batches" />
               </placeholder>
            </TableView>
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label fx:id="statusLabel" maxWidth="Infinity" styleClass="status-label" text="" HBox.hgrow="ALWAYS" />
            <Button fx:id="reserveButton" disable="true" mnemonicParsing="false" onAction="#onReserve" styleClass="btn-primary" text="Reserve selected batch" />
         </children>
      </HBox>
   </children>
</VBox>
